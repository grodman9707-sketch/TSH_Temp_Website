PORT=5173
HOST=0.0.0.0
# On Railway, create a Volume mounted at /data and set:
# DATA_DIR=/data
DATA_DIR=

# Railway PostgreSQL backup (optional). Add a PostgreSQL plugin, then on the
# web service set DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Airtable is unused. Owner data review uses Google Sheets via /api/export.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# Official Google Sheet for owner data review. Default is the league workbook.
# Override only if you switch to a different spreadsheet.
# GOOGLE_SHEETS_SPREADSHEET_ID=1Frq5HEWdD_Dld8bIOCq0_CqH7BaTY_ikgIHzqYMMmLY
